{
	"indentWidth": 1,
	"useTabs": true,
	"lineWidth": 100,
	"newLineKind": "lf",
	"typescript": {
		"quoteStyle": "preferDouble",
		"semicolons": "always",
		"trailingCommas": "always"
	},
	"json": {},
	"excludes": ["dist/", "node_modules/"],
	"plugins": [
		"npm:@dprint/typescript@0.99.2",
		"npm:@dprint/json@0.26.0"
	]
}
