{
	"name": "dataiku-sdk",
	"version": "0.12.4",
	"description": "Dataiku DSS SDK and CLI for programmatic access to DSS REST APIs",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"bin": {
		"dss": "bin/dss.js"
	},
	"files": [
		"dist/",
		"bin/dss.js",
		"packages/types/dist/"
	],
	"engines": {
		"node": ">=22.15.0",
		"bun": ">=1.3.14"
	},
	"scripts": {
		"build": "tsc && tsc -p packages/types/tsconfig.json",
		"prepack": "tsc && tsc -p packages/types/tsconfig.json",
		"prepublishOnly": "tsc && tsc -p packages/types/tsconfig.json",
		"check": "tsc --noEmit",
		"lint": "oxlint src/",
		"lint:fix": "oxlint --fix src/",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"test": "bun test",
		"test:platform": "bun scripts/platform-smoke.mjs",
		"test:integration": "cross-env RUN_DATAIKU_INTEGRATION=1 bun test tests/integration-playground.test.ts",
		"test:integration:mutating": "cross-env RUN_DATAIKU_INTEGRATION=1 RUN_DATAIKU_INTEGRATION_MUTATING=1 bun test tests/integration-playground.test.ts",
		"test:integration:rigorous": "cross-env RUN_DATAIKU_INTEGRATION=1 bun test tests/integration-rigorous.test.ts",
		"test:integration:rigorous:mutating": "cross-env RUN_DATAIKU_INTEGRATION=1 RUN_DATAIKU_INTEGRATION_MUTATING=1 bun test tests/integration-rigorous.test.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"cross-env": "^10.1.0",
		"dprint": "^0.54.0",
		"oxlint": "^1.68.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.49"
	},
	"bundledDependencies": [
		"@sinclair/typebox"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/clssck/dataiku-sdk.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"bundleDependencies": [
		"@sinclair/typebox"
	]
}
