{
	"name": "dataiku-sdk",
	"version": "1.0.0",
	"description": "Dataiku DSS SDK and CLI for programmatic access to DSS REST APIs",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"bin": {
		"dss": "bin/dss.js"
	},
	"files": [
		"dist/",
		"plugin.json",
		"skills/",
		"bin/dss.js",
		"packages/types/dist/"
	],
	"engines": {
		"node": ">=22.15.0",
		"bun": ">=1.3.14"
	},
	"scripts": {
		"build": "tsc && node scripts/generate-build-metadata.mjs && tsc -p packages/types/tsconfig.json",
		"prepack": "node scripts/sync-plugin-version.mjs --check && tsc && node scripts/generate-build-metadata.mjs && tsc -p packages/types/tsconfig.json",
		"prepublishOnly": "node scripts/sync-plugin-version.mjs --check && tsc && node scripts/generate-build-metadata.mjs && tsc -p packages/types/tsconfig.json",
		"check": "tsc --noEmit && node scripts/sync-plugin-version.mjs --check",
		"version": "node scripts/sync-plugin-version.mjs && git add plugin.json",
		"lint": "oxlint src/",
		"lint:fix": "oxlint --fix src/",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"test": "bun test",
		"test:tokens": "bun test tests/cli/agent-token-budget.test.ts",
		"test:platform": "bun scripts/platform-smoke.mjs",
		"test:integration": "cross-env RUN_DATAIKU_INTEGRATION=1 bun test tests/integration-playground.test.ts",
		"test:integration:mutating": "cross-env RUN_DATAIKU_INTEGRATION=1 RUN_DATAIKU_INTEGRATION_MUTATING=1 bun test tests/integration-playground.test.ts",
		"test:integration:rigorous": "cross-env RUN_DATAIKU_INTEGRATION=1 bun test tests/integration-rigorous.test.ts",
		"test:integration:rigorous:mutating": "cross-env RUN_DATAIKU_INTEGRATION=1 RUN_DATAIKU_INTEGRATION_MUTATING=1 bun test tests/integration-rigorous.test.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"cross-env": "^10.1.0",
		"dprint": "^0.55.2",
		"js-tiktoken": "1.0.21",
		"oxlint": "^1.78.0",
		"typescript": "^7.0.2",
		"typescript-language-server": "5.3.0",
		"typescript-language-service": "npm:typescript@5.9.3"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52",
		"node-stream-zip": "^1.16.0"
	},
	"bundledDependencies": [
		"@sinclair/typebox"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/clssck/dataiku-sdk.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"bundleDependencies": [
		"@sinclair/typebox"
	]
}
