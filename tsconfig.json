{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"types": ["bun-types"],
		"paths": {
			"@dataiku/types": ["./packages/types/src/index.ts"]
		}
	},
	"include": ["src/**/*", "packages/types/src/**/*"]
}
